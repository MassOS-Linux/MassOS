+ac_cs_config='$ac_cs_config_escaped'
+ac_cs_version="\\
+GNU MP config.status 6.3.0
+configured by $0, generated by GNU Autoconf 2.72,
+  with options \\"\$ac_cs_config\\"
+
+Copyright (C) 2023 Free Software Foundation, Inc.
