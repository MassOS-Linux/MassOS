# This file contains a list of tasks to perform after a system upgrade. Aside
# from standard post-upgrade tasks, it can also contain specific tasks required
# to adapt an existing system to changes made by a newer MassOS version.

# systemd 258 removes this file, keeping it will cause warnings on bootup.
rm -f /usr/lib/systemd/system/systemd-update-utmp-runlevel.service || true

# Standard tasks to perform after an upgrade.
ldconfig
glib-compile-schemas /usr/share/glib-2.0/schemas
gdk-pixbuf-query-loaders --update-cache
gtk-update-icon-cache -q -t -f --include-image-data /usr/share/icons/hicolor
gtk4-update-icon-cache -q -t -f --include-image-data /usr/share/icons/hicolor
update-desktop-database
update-mime-database /usr/share/mime
fc-cache
dconf update
systemd-sysusers
systemd-hwdb update

# Regenerate CA certificate store data if it is outdated.
make-ca -C /usr/share/massos/certs/certdata.txt

# Generate SSH host keys if they are missing.
ssh-keygen -A

# Replace AppArmor profiles if they were installed as '.new'.
# TODO: Eventually allow UGM to have full directories in etc-force-replace...
echo "Note: Replacing AppArmor profiles with '.new' versions..." >&2
while read -r f; do
  mv -f "$f" "${f%.new}" || true
done < <(find /etc/apparmor.d -type f -name \*.new)
