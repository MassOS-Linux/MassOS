diff '--color=auto' -apruN a/src/gallium/frontends/xa/xa_yuv.c b/src/gallium/frontends/xa/xa_yuv.c
--- a/src/gallium/frontends/xa/xa_yuv.c	1970-01-01 01:00:00.000000000 +0100
+++ b/src/gallium/frontends/xa/xa_yuv.c	2026-02-27 18:24:46.201416995 +0000
@@ -0,0 +1,162 @@
+/**********************************************************
