# Directly modifying this file is discouraged; put your custom startup files in
# /etc/profile.d instead (the files there also take more priority than this).

# Set up environment variables.
# NOTE: sbin is a symlink to bin, so sbin entries aren't needed in PATH.
export PATH=/usr/local/bin:/usr/bin
export PKG_CONFIG_PATH=/usr/local/share/pkgconfig:/usr/local/lib/pkgconfig:/usr/share/pkgconfig:/usr/lib/pkgconfig
export HISTSIZE=10000
export HISTIGNORE="&:[bf]g:exit"
export XDG_DATA_DIRS=${XDG_DATA_DIRS:-/usr/share/}
export XDG_CONFIG_DIRS=${XDG_CONFIG_DIRS:-/etc/xdg/}
export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/tmp/xdg-$USER}

# Set up localization.
. /etc/locale.conf
export LANG

# Set up INPUTRC.
if [ -z "$INPUTRC" -a ! -f "$HOME/.inputrc" ]; then
  export INPUTRC=/etc/inputrc
fi

# PS1 prompts - RED for root, GREEN for users.
if [ -n "$ZSH_VERSION" ]; then
  # PS1 prompt for zsh.
  if [ $EUID -eq 0 ]; then
    PS1="%B%F{red}%n@%m%f%b %B%F{blue}%~%f%b # "
  else
    PS1="%B%F{green}%n@%m%f%b %B%F{blue}%~%f%b \$ "
  fi
else
  # PS1 prompt for normal shell.
  if [ $EUID -eq 0 ]; then
    PS1="\[\e[1;31m\]\u@\h\[\e[0m\]:\[\e[1;34m\]\w\[\e[0m\]# "
  else
    PS1="\[\e[1;32m\]\u@\h\[\e[0m\]:\[\e[1;34m\]\w\[\e[0m\]\$ "
  fi
fi
export PS1

# Set up an appropriate umask for newly created files and folders.
umask 0022

# Allow ls, grep and diff to provide colored output.
if [ -f "/etc/dircolors" ]; then
  eval $(dircolors -b /etc/dircolors)
fi
if [ -f "$HOME/.dircolors" ]; then
  eval $(dircolors -b $HOME/.dircolors)
fi
alias ls='ls --color=auto'
alias grep='grep --color=auto'
alias egrep='egrep --color=auto'
alias fgrep='fgrep --color=auto'
alias zgrep='zgrep --color=auto'
alias zegrep='zegrep --color=auto'
alias zfgrep='zfgrep --color=auto'
alias diff='diff --color=auto'

# Provide common ls aliases familiar to users of Ubuntu and related distros.
alias l='ls -CF'
alias la='ls -A'
alias ll='ls -aFl'

# Let the steam locomotive be merciful for careless users.
alias sl='sl -e'

# Load drop-in startup files from /etc/profile.d.
for script in /etc/profile.d/*.sh ; do
  if [ -r $script ]; then
    . $script
  fi
done
