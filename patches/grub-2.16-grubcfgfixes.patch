This is a unification of multiple (previously separate) GRUB patches applied by
MassOS, all of which make some tweaks to the default files which (at runtime)
are responsible for generating /boot/grub/grub.cfg.

1. Adds support for auto-detecting-and-inserting the correct parameters for an
installation which has LUKS disk encryption enabled. This patch inserts the
parameters to support BOTH dracut, and initramfs-tools/mkinitcpio.

2. Adds support for loading a device tree blob (DTB) file if one is specified.
DTBs are required on certain systems e.g. aarch64 laptops & SBCs. This patch is
derived from a downstream patch from Ubuntu, but with custom changes for MassOS
such that the DTB file can be specified in /etc/default/grub, rather than
needing to be symlinked in /boot (thus not requiring an update to the symlink
when a newer kernel version is installed, and thus supporting the situation
where /boot could be on a filesystem that doesn't support symlinks).

NOTE: The efi_uga patch is no longer included (like it was for the 2.14 version
of this patch), because this issue has been fixed in upstream.

diff '--color=auto' -apruN a/util/grub.d/10_linux.in b/util/grub.d/10_linux.in
--- a/util/grub.d/10_linux.in	2026-09-21 18:33:49.000000000 +0100
+++ b/util/grub.d/10_linux.in	2026-09-21 21:53:59.904950133 +0100
@@ -170,6 +170,13 @@ EOF
 	initrd	$(echo $initrd_path)
 EOF
   fi
+  if test -n "${dtb}" ; then
+    message="$(gettext_printf "Loading device tree blob ...")"
+    sed "s/^/$submenu_indentation/" << EOF
+	echo	'$(echo "$message" | grub_quote)'
+	devicetree	${rel_dirname}/${dtb}
+EOF
+  fi
   sed "s/^/$submenu_indentation/" << EOF
 }
 EOF
@@ -227,6 +234,17 @@ for linux in ${reverse_sorted_list}; do
   alt_version=`echo $version | sed -e "s,\.old$,,g"`
   linux_root_device_thisversion="${LINUX_ROOT_DEVICE}"
 
+  # Detect LUKS encryption and change parameters for initramfs.
+  luks_device=""
+  luks_uuid=""
+  if test "${GRUB_DEVICE}" = /dev/mapper/cryptroot; then
+    luks_device="$(cryptsetup status /dev/mapper/cryptroot 2>/dev/null || true)"
+    luks_uuid="$(blkid -s UUID -o value -t TYPE=crypto_LUKS "$(echo "${luks_device}" | grep 'device:' | xargs | cut -d' ' -f2)" || true)"
+  fi
+  if test -n "${luks_uuid}"; then
+    linux_root_device_thisversion="/dev/mapper/cryptroot cryptdevice=UUID=${luks_uuid}:cryptroot rd.luks.uuid=${luks_uuid} rd.luks.name=${luks_uuid}=cryptroot"
+  fi
+
   initrd_early=
   for i in ${GRUB_EARLY_INITRD_LINUX_STOCK} \
 	   ${GRUB_EARLY_INITRD_LINUX_CUSTOM}; do
@@ -263,6 +281,12 @@ for linux in ${reverse_sorted_list}; do
     gettext_printf "Found initrd image: %s\n" "$(echo $initrd_display)" >&2
   fi
 
+  dtb=
+  if test -n "${GRUB_DEVICETREE}" && test -e "${dirname}/dtbs-${version}/${GRUB_DEVICETREE}" ; then
+    dtb="dtbs-${version}/${GRUB_DEVICETREE}"
+    gettext_printf "Found device tree blob: %s\n" "${dirname}/${dtb}" >&2
+  fi
+
   config=
   for i in "${dirname}/config-${version}" "${dirname}/config-${alt_version}" "/etc/kernels/kernel-config-${version}" ; do
     if test -e "${i}" ; then
diff '--color=auto' -apruN a/util/grub-mkconfig.in b/util/grub-mkconfig.in
--- a/util/grub-mkconfig.in	2026-09-21 18:33:49.000000000 +0100
+++ b/util/grub-mkconfig.in	2026-09-21 21:53:59.905107395 +0100
@@ -238,6 +238,7 @@ export GRUB_DEFAULT \
   GRUB_BUTTON_CMOS_ADDRESS \
   GRUB_BUTTON_CMOS_CLEAN \
   GRUB_DISTRIBUTOR \
+  GRUB_DEVICETREE \
   GRUB_CMDLINE_LINUX \
   GRUB_CMDLINE_LINUX_DEFAULT \
   GRUB_CMDLINE_LINUX_RECOVERY \
