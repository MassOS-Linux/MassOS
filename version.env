# Do not modify this file unless you know what you are doing.
# This is used by 'stage1.sh' to set up OS information files.

# shellcheck shell=bash

# Base version (YYYY.MM).
VERSION_BASE=2026.09

# 0 for stable release build, >0 for dev build (incremental).
VERSION_DEV=0

# Increment only for hotfixes. This is ignored if dev build is set.
# Also 0 and 1 are treated the same here since hotfixes start at 2.
VERSION_HOTFIX=1
