+    }
+    else if (strncmp(tag, "BytesPerLine", 12) == 0)
+    {
+      get_element(tail, size-(tail-payload), value, sizeof(value), &tail);
+      resp->bytes_per_line = strtol(value, NULL, 10);
+    }
+  }
+  return 0;
+}
