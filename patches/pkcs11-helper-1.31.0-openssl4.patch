From 986fa2ffca1c6748d551c20c0172465112dcda50 Mon Sep 17 00:00:00 2001
From: Simo Sorce <simo@redhat.com>
Date: Mon, 20 Apr 2026 13:23:37 -0400
Subject: [PATCH] Use ASN1_TIME_to_tm for certificate expiration

Replaced manual string parsing of the 'notAfter' ASN.1 time structure with the
standard OpenSSL function ASN1_TIME_to_tm(). This is necessary because in
OpenSSL 4.0 ASN1_TIME is now an opaque structure. This also simplifies the
code and properly handles various ASN.1 time formats safely without relying
on hardcoded string indices.

Co-authored-by: Gemini <gemini@google.com>
Signed-off-by: Simo Sorce <simo@redhat.com>
---
 lib/_pkcs11h-crypto-openssl.c | 17 +++++------------
 1 file changed, 5 insertions(+), 12 deletions(-)

diff --git a/lib/_pkcs11h-crypto-openssl.c b/lib/_pkcs11h-crypto-openssl.c
index 05af65e..9dc2be2 100644
--- a/lib/_pkcs11h-crypto-openssl.c
+++ b/lib/_pkcs11h-crypto-openssl.c
@@ -148,21 +148,14 @@ __pkcs11h_crypto_openssl_certificate_get_expiration (
 		notBefore != NULL &&
 		notAfter != NULL &&
 		X509_cmp_current_time (notBefore) <= 0 &&
-		X509_cmp_current_time (notAfter) >= 0 &&
-		notAfter->length >= 12
+		X509_cmp_current_time (notAfter) >= 0
 	) {
 		struct tm tm1;
 
-		memset (&tm1, 0, sizeof (tm1));
-		tm1.tm_year = (notAfter->data[ 0] - '0') * 10 + (notAfter->data[ 1] - '0') + 100;
-		tm1.tm_mon  = (notAfter->data[ 2] - '0') * 10 + (notAfter->data[ 3] - '0') - 1;
-		tm1.tm_mday = (notAfter->data[ 4] - '0') * 10 + (notAfter->data[ 5] - '0');
-		tm1.tm_hour = (notAfter->data[ 6] - '0') * 10 + (notAfter->data[ 7] - '0');
-		tm1.tm_min  = (notAfter->data[ 8] - '0') * 10 + (notAfter->data[ 9] - '0');
-		tm1.tm_sec  = (notAfter->data[10] - '0') * 10 + (notAfter->data[11] - '0');
-
-		*expiration = mktime (&tm1);
-		*expiration += (int)(mktime (localtime (expiration)) - mktime (gmtime (expiration)));
+		if (ASN1_TIME_to_tm (notAfter, &tm1)) {
+			*expiration = mktime (&tm1);
+			*expiration += (int)(mktime (localtime (expiration)) - mktime (gmtime (expiration)));
+		}
 	}
 
 cleanup:
