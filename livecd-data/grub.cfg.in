# DO NOT EDIT/MODIFY THIS FILE! IT MAY MAKE THIS INSTALLATION MEDIA UNBOOTABLE!
# This is the second-stage GRUB configuration file for MassOS Live CD (UEFI).
# It is called by the first-stage stub configuration in the signed GRUB image.
# The first-stage configuration will have already loaded any necessary modules.
# See the file 'keys/README.md' in the MassOS repository for more information.

set timeout=30

menuentry "MassOS @@VERSION@@ LIVE" {
  linux /vmlinuz root=live:LABEL=MASSOS_LIVE iso-scan/filename="@@ISOFILE@@" ro quiet splash rd.live.image
  initrd /initramfs.img
}

menuentry "MassOS @@VERSION@@ LIVE (RAM)" {
  linux /vmlinuz root=live:LABEL=MASSOS_LIVE iso-scan/filename="@@ISOFILE@@" ro quiet splash rd.live.image rd.live.ram
  initrd /initramfs.img
}

menuentry "MassOS @@VERSION@@ LIVE (nomodeset)" {
  linux /vmlinuz root=live:LABEL=MASSOS_LIVE iso-scan/filename="@@ISOFILE@@" ro quiet splash rd.live.image nomodeset
  initrd /initramfs.img
}

menuentry "MassOS @@VERSION@@ LIVE (RAM + nomodeset)" {
  linux /vmlinuz root=live:LABEL=MASSOS_LIVE iso-scan/filename="@@ISOFILE@@" ro quiet splash rd.live.image rd.live.ram nomodeset
  initrd /initramfs.img
}

# Memtest86+ is only supported on x86_64.
if test "$grub_cpu" = "x86_64"; then
  menuentry "Run memory test (Memtest86+)" {
    chainloader /EFI/tools/memtest64.efi
  }
fi

menuentry "Boot from local disk" {
  exit 1
}

menuentry "Boot from network (iPXE)" {
  chainloader /EFI/tools/ipxe.efi
}

menuentry "Import Secure Boot keys (MokManager)" {
  chainloader "/EFI/BOOT/mm$efi_suffix.efi"
}

# The UEFI EDK2 Shell is not signed for secure boot and contains no SBAT data.
# This is because it is considered a debug tool, and it can bypass secure boot.
# So the menuentry should only show if secure boot is disabled.
if test "$lockdown" != "y"; then
  menuentry "UEFI EDK2 Shell" {
    chainloader "/EFI/tools/shell$efi_suffix.efi"
  }
fi

# Some older UEFI firmwares do not support the 'reboot into firmware' option.
# If this is the case, the menuentry should not be shown.
if fwsetup --is-supported; then
  menuentry "UEFI Firmware Settings" {
    fwsetup
  }
fi

menuentry "Reboot system" {
  reboot
}

menuentry "Shut down system" {
  halt
}
