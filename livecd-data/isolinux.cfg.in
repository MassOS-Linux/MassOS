UI vesamenu.c32
PROMPT 0
TIMEOUT 200
ONTIMEOUT massos

MENU TITLE Welcome to MassOS
MENU BACKGROUND splash.png

LABEL massos
MENU LABEL MassOS Live CD
KERNEL /vmlinuz
APPEND initrd=/initramfs.img root=live:LABEL=MASSOS_LIVE iso-scan/filename="@@ISOFILE@@" ro quiet splash rd.live.image

LABEL massos-copytoram
MENU LABEL MassOS Live CD (copy-to-RAM, high memory systems)
KERNEL /vmlinuz
APPEND initrd=/initramfs.img root=live:LABEL=MASSOS_LIVE iso-scan/filename="@@ISOFILE@@" ro quiet splash rd.live.image rd.live.ram

LABEL massos-nomodeset
MENU LABEL MassOS Live CD (fallback graphics, unsupported GPUs)
KERNEL /vmlinuz
APPEND initrd=/initramfs.img root=live:LABEL=MASSOS_LIVE iso-scan/filename="@@ISOFILE@@" ro quiet splash rd.live.image nomodeset

LABEL massos-copytoram-nomodeset
MENU LABEL MassOS Live CD (copy-to-RAM + fallback graphics)
KERNEL /vmlinuz
APPEND initrd=/initramfs.img root=live:LABEL=MASSOS_LIVE iso-scan/filename="@@ISOFILE@@" ro quiet splash rd.live.image rd.live.ram nomodeset

LABEL memtest
MENU LABEL Run memory test (Memtest86+)
KERNEL memtest64.bin

LABEL localboot
MENU LABEL Boot from local disk
COM32 chain.c32
APPEND hd0 0

LABEL ipxe
MENU LABEL Boot from network (iPXE)
KERNEL ipxe.lkrn

LABEL reboot
MENU LABEL Reboot system
COM32 reboot.c32

LABEL poweroff
MENU LABEL Shut down system
COM32 poweroff.c32
